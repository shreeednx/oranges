// (oranges) FSR 1's RCAS at the present: EASU's output sharpened, into the image that goes to the window (an RGBA8
// image written through a UNORM view: the values stay gamma-encoded, as they came). AMD's RCAS
// (third_party/fidelityfx-fsr1, MIT), 32-bit path. Push constants: con as FsrRcasCon makes it (con.x: the sharpness,
// exp2(-stops), as float bits); sharpen 0 copies the input through unchanged (the Sharpness setting's Off).
// Compiled into fsr1_rcas_comp_spv.h by `python -m oranges.shaders`.
#version 450
#extension GL_GOOGLE_include_directive : require

#define FFX_GPU 1
#define FFX_GLSL 1
#define FSR_RCAS_F 1

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D upscaled;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D shown;
layout(push_constant) uniform Constants {
    uvec4 con;
    uint sharpen;
} pc;

#include "ffx_core.h"

FfxFloat32x4 FsrRcasLoadF(FfxInt32x2 p) {   // (clamped: a fetch outside the image is undefined without robustness)
    return texelFetch(upscaled, clamp(p, ivec2(0), textureSize(upscaled, 0) - 1), 0);
}
void FsrRcasInputF(inout FfxFloat32 r, inout FfxFloat32 g, inout FfxFloat32 b) {}

#include "fsr1/ffx_fsr1.h"

void main() {
    const uvec2 ip = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(ip, uvec2(imageSize(shown))))) return;
    vec3 c;
    if (pc.sharpen != 0u) FsrRcasF(c.r, c.g, c.b, ip, pc.con);
    else c = texelFetch(upscaled, ivec2(ip), 0).rgb;
    imageStore(shown, ivec2(ip), vec4(c, 1.0));
}
